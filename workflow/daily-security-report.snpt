        "isCloud": false,
        "connectionType": "ORCHESTRATOR"
      }
    },
    {
      "nodeId": "6993e979-88b9-443a-97fe-2943535423a8",
      "name": "Alerts Customer",
      "description": "",
      "type": "action",
