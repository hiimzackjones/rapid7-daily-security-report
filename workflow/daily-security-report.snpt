            "terms": [],
            "end_time": "{{[\"Now\"].[datetime]}}",
            "field_ids": [],
            "rrns_only": true,
            "aggregates": [],
            "start_time": "{{[\"Cutoff 24h\"].[date]}}",
            "leql": ""
          }
        },
        "identifier": "search_alerts",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "rapid7_insightidr",
          "vendor": "rapid7",
          "version": "12.0.10"
        },
        "connectionId": "REPLACE-WITH-YOUR-INSIGHTIDR-CONNECTION",
        "isCloud": true,
        "connectionType": "CONNECTION"
      }
    },
    {
      "nodeId": "227291d5-c320-4912-b90d-e677bdbd39bb",
      "name": "Cutoff 24h",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "days": 1,
            "hours": 0,
            "years": 0,
            "months": 0,
            "minutes": 0,
            "seconds": 0,
            "base_time": "{{[\"Now\"].[datetime]}}"
          }
        },
        "identifier": "subtract_from_datetime",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "datetime",
          "vendor": "rapid7",
          "version": "3.0.7"
        },
