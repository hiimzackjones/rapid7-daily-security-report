      }
    },
    {
      "nodeId": "6ed76672-27cb-4d7d-831b-73a964cd2cea",
      "name": "Inv New",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "size": 25,
            "sort": [],
            "index": 0,
            "search": [],
            "end_time": "{{[\"Now\"].[datetime]}}",
            "start_time": "{{[\"Cutoff 24h\"].[date]}}"
          }
        },
        "identifier": "search_investigations",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "rapid7_insightidr",
          "vendor": "rapid7",
          "version": "12.0.10"
