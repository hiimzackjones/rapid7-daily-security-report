      }
    },
    {
      "nodeId": "de8abbf2-26be-4d9d-b40c-c52b3bb93d23",
      "name": "Now Friendly",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "format_string": "%d %b %Y %H:%M:%S",
            "use_rfc3339_format": false
          }
        },
        "identifier": "get_datetime",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "datetime",
          "vendor": "rapid7",
          "version": "3.0.7"
        },
        "orchestratorId": "REPLACE-WITH-YOUR-ORCHESTRATOR-ID",
        "isCloud": false,
        "connectionType": "ORCHESTRATOR"
      }
    },
    {
      "nodeId": "d1c9e289-919e-4fcd-959d-025e73acdd12",
      "name": "Now ET",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "base_time": "{{[\"Now Friendly\"].[datetime]}}",
            "timezone": "America/New_York"
          }
        },
        "identifier": "to_localtime",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
