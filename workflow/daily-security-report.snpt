{
  "name": "Daily Security Report (Community Edition)",
  "summary": "Daily security report: InsightIDR alerts/investigations, Surface Command EPP health, CISA KEV vulns -> email-ready HTML. Stock plugins only.",
  "tags": [
    "report",
    "insightidr",
    "surface-command"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputValues": null,
  "notes": "See README: re-point connections after import; run tools/localize_template.py after first export to bind template refs to your org's nodeIds.",
  "steps": [
    {
      "nodeId": "0050e78a-fe8b-4eac-8dd3-af0fe4be67d5",
      "name": "SC KEV Top",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "cypher": "MATCH (v:Vulnerability)\nWHERE v.is_exploited = true\nRETURN v.name AS cve, v.severity AS severity, v.cvss AS cvss,\n       v.rapid7_active_risk_score AS active_risk, v.has_resolution AS fix_available\nORDER BY active_risk DESC\nLIMIT 10"
          }
        },
        "identifier": "run_adhoc_query",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "rapid7_surface_command",
          "vendor": "rapid7",
          "version": "1.2.0"
        },
        "connectionId": "REPLACE-WITH-YOUR-SURFACE-COMMAND-CONNECTION",
        "isCloud": true,
        "connectionType": "CONNECTION"
      }
    },
    {
      "nodeId": "032b54aa-0053-4e31-9586-65c8138e0b43",
      "name": "Now",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "format_string": "%d %b %Y %H:%M:%S",
            "use_rfc3339_format": true
          }
        },
        "identifier": "get_datetime",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "datetime",
          "vendor": "rapid7",
          "version": "3.0.7"
        },
        "orchestratorId": "REPLACE-WITH-YOUR-ORCHESTRATOR-ID",
        "isCloud": false,
        "connectionType": "ORCHESTRATOR"
      }
    },
    {
      "nodeId": "0ae58ab8-ddbe-457d-9e8f-1ae3537ef539",
