        "isCloud": false,
        "connectionType": "ORCHESTRATOR"
      }
    },
    {
      "nodeId": "35cb6d73-7d26-489e-84d6-b2e62a5971ab",
      "name": "Inv Open",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "size": 1,
            "sort": [],
            "index": 0,
            "search": [
              {
                "field": "status",
                "value": "OPEN",
                "operator": "EQUALS"
              }
            ]
          }
        },
        "identifier": "search_investigations",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "rapid7_insightidr",
          "vendor": "rapid7",
          "version": "12.0.10"
        },
        "connectionId": "REPLACE-WITH-YOUR-INSIGHTIDR-CONNECTION",
        "isCloud": true,
        "connectionType": "CONNECTION"
      }
    },
    {
      "nodeId": "56ba1fe9-1860-48f4-920c-0514a827de87",
      "name": "SC KEV Counts",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "cypher": "MATCH (v:Vulnerability)\nWHERE v.is_exploited = true\nRETURN count(v) AS kev_count,\n       sum(CASE WHEN v.has_resolution = true THEN 1 ELSE 0 END) AS kev_with_fix"
          }
        },
        "identifier": "run_adhoc_query",
        "continueOnFailure": false,
        "isDisabled": false,
        "plugin": {
          "name": "rapid7_surface_command",
          "vendor": "rapid7",
          "version": "1.2.0"
        },
        "connectionId": "REPLACE-WITH-YOUR-SURFACE-COMMAND-CONNECTION",
        "isCloud": true,
        "connectionType": "CONNECTION"
      }
    },
    {
      "nodeId": "66731b57-1cf9-4d3b-a45a-2fc810317709",
      "name": "Cutoff 7d",
      "description": "",
      "type": "action",
      "metadata": {
        "parameters": {
          "input": {
            "days": 7,
            "hours": 0,
            "years": 0,
            "months": 0,
            "minutes": 0,
            "seconds": 0,
            "base_time": "{{[\"Now\"].[datetime]}}"
          }
        },
        "identifier": "subtract_from_datetime",
